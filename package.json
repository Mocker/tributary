{
  "name": "tributary",
  "version": "0.1.0",
  "description": "Tributary: Agent-Native Code Collaboration Plane on Cloudflare Workers & Artifacts",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:ui": "npm --prefix ui install --no-audit --no-fund && npm --prefix ui run build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "simulate": "tsx scripts/run-demo-script.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "seed": "tsx scripts/seed-baseline.ts"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "ulid": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@types/node": "^22.7.4",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "wrangler": "^4.149.0",
    "z3-solver": "^5.2.0"
  },
  "author": "Ryan Guthrie",
  "license": "MIT"
}
