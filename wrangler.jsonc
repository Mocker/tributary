{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tributary",
  "account_id": "162681bef56337d181bf689c4b77268c",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Cloudflare Artifacts: Git-compatible versioned filesystem
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "tributary"
    }
  ],

  // Durable Objects: one ChangeProposal DO per proposal (single-writer serialization)
  "durable_objects": {
    "bindings": [
      {
        "name": "CHANGE_PROPOSAL_DO",
        "class_name": "ChangeProposalDO"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChangeProposalDO"]
    }
  ],

  // Radar UI: React + Vite app in ui/, built to ui/dist and served as static
  // assets. Requests that match no asset fall through to the Worker (/v1 API).
  "assets": {
    "directory": "./ui/dist",
    "not_found_handling": "single-page-application"
  },

  // Build the radar UI before deploy (runs after wrangler's npm install)
  "build": {
    "command": "npm run build:ui"
  },

  // KV: Fast cache for repo metadata and intervention requests
  "kv_namespaces": [
    {
      "binding": "TRIBUTARY_KV",
      "id": "8221143a7e76470a897ce32612a52acd"
    }
  ],

  "vars": {
    "ENVIRONMENT": "development",
    "DEFAULT_BASELINE_REPO": "demo-shop"
  }
}
