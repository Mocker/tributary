{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tributary",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Cloudflare Artifacts: Git-compatible versioned filesystem
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "tributary"
    }
  ],

  // Durable Objects: one ChangeProposal DO per proposal (single-writer serialization)
  "durable_objects": {
    "bindings": [
      {
        "name": "CHANGE_PROPOSAL_DO",
        "class_name": "ChangeProposalDO"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["ChangeProposalDO"]
    }
  ],

  // KV: Fast cache for repo metadata and intervention requests
  "kv_namespaces": [
    {
      "binding": "TRIBUTARY_KV",
      "id": "tributary_kv_namespace_id"
    }
  ],

  "vars": {
    "ENVIRONMENT": "development",
    "GATE_HMAC_SECRET": "tributary-demo-secret-2026",
    "DEFAULT_BASELINE_REPO": "demo-shop"
  }
}
